# Copy to /etc/co-story/runtime.env with owner root:co-story and mode 0640.
# Obtain secret values at deploy time; never commit this populated file.
CO_STORY_ENV=production
DATABASE_URL=
CO_STORY_COOKIE_SECURE=true
CO_STORY_ALLOWED_HOSTS=
CO_STORY_ALLOWED_ORIGINS=
CO_STORY_AWS_REGION=
CO_STORY_BEDROCK_MODEL_ID=
CO_STORY_BEDROCK_GUARDRAIL_ID=
CO_STORY_BEDROCK_GUARDRAIL_VERSION=
CO_STORY_BEDROCK_MAX_TOKENS=800
CO_STORY_APPLICATION_LOG_PATH=/var/log/co-story/application.jsonl
