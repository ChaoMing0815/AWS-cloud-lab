[Unit]
Description=Co-Story candidate release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=co-story
Group=co-story
WorkingDirectory=/opt/co-story/releases/%i/backend
EnvironmentFile=/etc/co-story/runtime.env
EnvironmentFile=/etc/co-story/database.env
Environment=CO_STORY_APPLICATION_LOG_PATH=/var/log/co-story/candidate.jsonl
LogsDirectory=co-story
LogsDirectoryMode=0750
ExecStart=/opt/co-story/releases/%i/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8001 --workers 1
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
