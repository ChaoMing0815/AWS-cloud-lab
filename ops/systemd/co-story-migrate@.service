[Unit]
Description=Co-Story schema update for release %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=co-story
Group=co-story
WorkingDirectory=/opt/co-story/releases/%i/backend
EnvironmentFile=/etc/co-story/runtime.env
ExecStart=/opt/co-story/releases/%i/.venv/bin/python -m app.commands.migrate
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

