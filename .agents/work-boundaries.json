  "branches": {
    "codex/story-quality": {
      "purpose": "改善玩家行為、危機、進度與結局的敘事品質及相關網頁體驗",
      "allowed_paths": [
        "backend/app/adapters/bedrock_storyteller.py",
        "backend/app/adapters/mock_storyteller.py",
        "backend/tests/test_bedrock_storyteller.py",
        "backend/tests/test_ending_policy.py",
        "backend/tests/test_story*.py",
        "backend/tests/test_world_generation_api.py",
        "web/**",
        "docs/architecture/llm-integration.md",
        "docs/features/story-quality.md",
        "docs/evidence/2026-*-story-quality/**"
      ]
    },
    "codex/tier3-delivery": {
      "purpose": "建立容器、ECR、GitHub OIDC、CI/CD、SSM release 與 rollback 垂直切片",
      "allowed_paths": [
        ".dockerignore",
        ".github/workflows/**",
        "Dockerfile",
        "Dockerfile.*",
        "backend/requirements-prod.txt",
        "backend/tests/test_container*.py",
        "backend/tests/test_github_ci_workflow.py",
        "backend/tests/test_tier3*.py",
        "docker-compose*.yml",
        "docs/architecture/tier3-*.md",
        "docs/evidence/2026-*-tier3-*/**",
        "docs/runbooks/tier3-*.md",
        "infra/cloudformation/tier3-*.yaml",
        "ops/container/**",
        "ops/release/**",
        "ops/systemd/co-story-container*.service"
      ]
    },
    "codex/tier3-production-release": {
      "purpose": "完成 T3B production release 前置相容性、人工核准 handoff、部署驗證與 rollback 證據",
      "allowed_paths": [
        ".github/workflows/ci.yml",
        ".github/workflows/tier3-release.yml",
        "Dockerfile",
        "backend/tests/test_container*.py",
        "backend/tests/test_github_ci_workflow.py",
        "backend/tests/test_tier3*.py",
        "docs/evidence/2026-*-tier3-production-release/**",
        "docs/runbooks/tier3-container-release.md",
        "infra/cloudformation/tier3-delivery.yaml",
        "ops/release/deploy_container.sh",
        "ops/release/write_delivery_metrics.py",
        "ops/systemd/co-story-container.service"
      ]
    },
    "codex/tier3-healthcheck-correction": {
      "purpose": "修正首次容器切換後 Docker HEALTHCHECK 的 production Host header 相容性，並準備後續 digest-release 驗證",
      "allowed_paths": [
        "Dockerfile",
        "ops/container/healthcheck.py",
        "backend/tests/test_container*.py",
        "docs/evidence/2026-*-tier3-production-release/**"
      ]
    },
    "codex/tier2-components": {
      "purpose": "建立 Web／Story Worker／Data 的本地組件邊界與第一個 queue／job contract，不部署 AWS",
      "allowed_paths": [
        "backend/app/application/ports.py",
        "backend/app/application/room_service.py",
        "backend/app/application/story_jobs.py",
        "backend/app/application/story_resolution.py",
        "backend/app/domain/story_jobs.py",
        "backend/app/domain/story_resolution.py",
        "backend/app/adapters/memory_story_job_queue.py",
        "backend/app/adapters/memory_story_resolution_store.py",
        "backend/app/adapters/postgres_story_job_queue.py",
        "backend/app/adapters/postgres_story_resolution_store.py",
