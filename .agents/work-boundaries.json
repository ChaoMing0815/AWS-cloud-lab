        "docs/decisions/0004-adopt-replay-safe-story-results.md",
        "docs/architecture/tier2-components.md",
        "docs/features/tier2-story-resolution.md",
        "docs/features/tier2-async-flow.md",
        "docs/evidence/2026-*-tier2-async-flow/**"
      ]
