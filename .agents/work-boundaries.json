{
  "version": 1,
  "protected_paths": [
    ".agents/work-boundaries.json",
    "AGENTS.md",
    "README.md",
    "docs/checkpoints.md",
    "docs/deployment-log.md",
    "docs/governance/parallel-branch-boundaries.md",
    "docs/handoffs/CURRENT.md",
    "docs/product/source-of-truth.md",
    "docs/project-plan.md",
    "docs/task-list.md",
    "scripts/check_branch_boundaries.py"
