        "backend/migrations/003_create_story_resolution_results.sql",
        "backend/tests/test_story_job*.py",
        "backend/tests/test_story_resolution*.py",
        "backend/tests/test_postgres_story_job_queue.py",
        "backend/tests/test_postgres_story_job_migration.py",
        "backend/tests/test_postgres_story_resolution_store.py",
        "backend/tests/test_postgres_story_resolution_migration.py",
        "backend/tests/test_migration_readiness.py",
        "docs/decisions/0004-adopt-replay-safe-story-results.md",
